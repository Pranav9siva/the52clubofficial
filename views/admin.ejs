<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | The 52 Club</title>
    <link rel="icon" href="/static/club/logo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #0a0a0a;
            --bg-card: #121212;
            --bg-input: #1a1a1a;
            --border-color: #242424;
            --text-primary: #ffffff;
            --text-secondary: #8a8a8a;
            --accent-green: #10b981;
            --accent-amber: #f59e0b;
            --accent-red: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        /* Top Header */
        .admin-header {
            background: #000000;
            border-bottom: 1px solid var(--border-color);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-logo {
            height: 36px;
            width: auto;
        }

        .header-title-group h1 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .header-badge {
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-weight: 700;
            display: inline-block;
            margin-left: 8px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-view-site {
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-view-site:hover {
            border-color: #666666;
            background: #181818;
        }

        .btn-logout {
            background: #1a1a1a;
            color: #aaaaaa;
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-logout:hover {
            color: #ffffff;
            background: #222222;
        }

        /* Container */
        .admin-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 32px 24px;
        }

        /* Flash Message */
        .toast-msg {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid var(--accent-green);
            color: #a7f3d0;
            padding: 14px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .stat-sub {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* Navigation Tabs */
        .admin-nav-tabs {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 28px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 700;
            padding: 12px 20px;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-primary);
        }

        .tab-btn.active {
            color: var(--text-primary);
            border-bottom-color: #ffffff;
        }

        /* Card Section */
        .section-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 28px;
            margin-bottom: 32px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .section-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* Controls: Search, Filter, Buttons */
        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
            width: 240px;
            transition: border-color 0.2s ease;
        }

        .search-input:focus {
            border-color: #ffffff;
        }

        .btn-action {
            background: #ffffff;
            color: #000000;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-action:hover {
            opacity: 0.9;
        }

        .btn-secondary {
            background: #1e1e1e;
            color: #ffffff;
            border: 1px solid var(--border-color);
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-secondary:hover {
            background: #282828;
            border-color: #555555;
        }

        /* Table */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }

        .data-table th {
            background: #161616;
            padding: 14px 16px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .data-table td {
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        .data-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .member-name {
            font-weight: 700;
            color: #ffffff;
        }

        .member-meta {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* Badges */
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-badge.paid {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-badge.pending {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* Table Action Buttons */
        .btn-table-toggle {
            background: transparent;
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-table-toggle:hover {
            background: #222222;
            border-color: #666666;
        }

        .btn-table-delete {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-left: 6px;
        }

        .btn-table-delete:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--accent-red);
        }

        .btn-table-edit {
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.35);
            color: #93c5fd;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-right: 6px;
        }

        .btn-table-edit:hover {
            background: rgba(59, 130, 246, 0.25);
            border-color: #60a5fa;
            color: #ffffff;
        }

        /* Collaborations styling */
        .collab-admin-card {
            background: #161616;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .collab-cat-pill {
            display: inline-block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #93c5fd;
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.25);
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 8px;
            align-self: flex-start;
        }

        /* Modal Overlays */
        .modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
            box-sizing: border-box;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-card {
            background: #141414;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            width: 100%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
            padding: 24px;
            box-sizing: border-box;
            animation: modalFadeIn 0.2s ease-out;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .modal-title {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #ffffff;
            margin: 0;
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .modal-close:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .btn-modal-cancel {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-modal-cancel:hover {
            color: #ffffff;
            border-color: #666;
            background: #222;
        }

        /* Forms in Settings & Modals */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .form-input-box {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .form-input-box:focus {
            border-color: #ffffff;
        }

        .form-hint {
            font-size: 11px;
            color: #666666;
            margin-top: 6px;
        }

        /* Cards for Events & Gallery */
        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .event-admin-card {
            background: #161616;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .event-admin-title {
            font-size: 15px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .event-admin-detail {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        @media (max-width: 768px) {
            .admin-header {
                padding: 14px 18px;
            }
            .admin-container {
                padding: 20px 14px;
            }
            .search-input {
                width: 100%;
            }
            .section-actions {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="admin-header">
        <div class="header-left">
            <img src="/static/club/logo.png" alt="The 52 Club" class="header-logo">
            <div class="header-title-group">
                <h1>The 52 Club <span class="header-badge">Admin</span></h1>
            </div>
        </div>
        <div class="header-right">
            <a href="/" target="_blank" class="btn-view-site">View Website</a>
            <form action="/admin/logout" method="POST" style="margin: 0;" onsubmit="localStorage.removeItem('the52_admin_auth'); sessionStorage.removeItem('the52_admin_auth');">
                <button type="submit" class="btn-logout">Sign Out</button>
            </form>
        </div>
    </header>

    <main class="admin-container">

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="toast-msg">
                <span><%= success %></span>
                <span style="cursor: pointer;" onclick="this.parentElement.remove()">✕</span>
            </div>
        <% } %>

        <!-- Stats Overview -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Registrations</div>
                <div class="stat-value"><%= stats.totalMembers %></div>
                <div class="stat-sub"><%= stats.paidCount %> verified, <%= stats.pendingCount %> pending</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Revenue Collected</div>
                <div class="stat-value">₹<%= stats.totalRevenue %></div>
                <div class="stat-sub">Based on ₹<%= settings.registration_fee %>/member</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Pending Payments</div>
                <div class="stat-value" style="color: var(--accent-amber);"><%= stats.pendingCount %></div>
                <div class="stat-sub">Awaiting verification</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Events</div>
                <div class="stat-value"><%= events.length %></div>
                <div class="stat-sub">Platform sessions</div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="admin-nav-tabs">
            <button class="tab-btn active" onclick="switchTab('tab-members')">Registrations (<%= stats.totalMembers %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-events')">Events & Sessions (<%= events.length %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-collaborations')">Collaborations (<%= (typeof collaborators !== 'undefined' ? collaborators.length : 0) %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-gallery')">Gallery</button>
            <button class="tab-btn" onclick="switchTab('tab-settings')">Pricing & Payments</button>
        </div>

        <!-- TAB 1: MEMBERS / REGISTRATIONS -->
        <div id="tab-members" class="tab-content active">
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Registered Members</h2>
                    </div>
                    <div class="section-actions">
                        <input type="text" id="memberSearch" class="search-input" placeholder="Search name, email, phone..." oninput="filterMembers()">
                        <select id="statusFilter" class="search-input" style="width: auto;" onchange="filterMembers()">
                            <option value="all">All Statuses</option>
                            <option value="completed">Completed / Paid</option>
                            <option value="pending">Pending</option>
                        </select>
                        <a href="/admin/export-csv" class="btn-action">Export CSV</a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="membersTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Member</th>
                                <th>Phone</th>
                                <th>Level</th>
                                <th>Payment</th>
                                <th>Txn / Order ID</th>
                                <th>Registered</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (members.length === 0) { %>
                                <tr>
                                    <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 36px;">
                                        No registrations recorded yet.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% members.forEach(function(m, idx) { %>
                                <tr class="member-row" data-name="<%= (m.full_name || '').toLowerCase() %>" data-email="<%= (m.email || '').toLowerCase() %>" data-phone="<%= m.phone || '' %>" data-status="<%= m.payment_status %>">
                                    <td style="color: var(--text-secondary); font-weight: 700;"><%= idx + 1 %></td>
                                    <td>
                                        <div class="member-name"><%= m.full_name %></div>
                                        <div class="member-meta"><%= m.email %></div>
                                        <% if (m.message) { %>
                                            <div class="member-meta" style="font-style: italic; color: #aaaaaa; margin-top: 2px;">"<%= m.message %>"</div>
                                        <% } %>
                                    </td>
                                    <td><%= m.phone %></td>
                                    <td style="text-transform: capitalize; color: #cccccc;"><%= m.experience || 'beginner' %></td>
                                    <td>
                                        <% if (m.payment_status === 'completed') { %>
                                            <span class="status-badge paid">PAID</span>
                                        <% } else { %>
                                            <span class="status-badge pending">PENDING</span>
                                        <% } %>
                                    </td>
                                    <td style="font-family: monospace; font-size: 11px; color: #888888;">
                                        <%= (m.transaction_id || '').slice(0, 16) %>...
                                        <% if (m.razorpay_payment_id) { %>
                                            <div style="color: #666666;"><%= m.razorpay_payment_id %></div>
                                        <% } %>
                                    </td>
                                    <td style="font-size: 12px; color: var(--text-secondary);">
                                        <%= m.registered_at ? new Date(m.registered_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Recent' %>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap;">
                                        <button type="button" class="btn-table-edit"
                                            data-id="<%= m.id %>"
                                            data-name="<%= m.full_name || '' %>"
                                            data-email="<%= m.email || '' %>"
                                            data-phone="<%= m.phone || '' %>"
                                            data-experience="<%= m.experience || 'beginner' %>"
                                            data-status="<%= m.payment_status %>"
                                            data-message="<%= m.message || '' %>"
                                            onclick="openEditMember(this)">Edit</button>
                                        <form action="/admin/members/<%= m.id %>/toggle-payment?auth=1" method="POST" style="display: inline;">
                                            <input type="hidden" name="auth" value="1">
                                            <button type="submit" class="btn-table-toggle" title="Toggle status">
                                                <%= m.payment_status === 'completed' ? 'Mark Pending' : 'Mark Paid' %>
                                            </button>
                                        </form>
                                        <form id="delete-member-<%= m.id %>" action="/admin/members/<%= m.id %>/delete?auth=1" method="POST" style="display: inline;">
                                            <input type="hidden" name="auth" value="1">
                                            <button type="button" class="btn-table-delete" title="Delete member"
                                                data-form-id="delete-member-<%= m.id %>"
                                                data-name="<%= m.full_name || 'Member #' + m.id %>"
                                                onclick="triggerMemberDelete(this)">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: EVENTS -->
        <div id="tab-events" class="tab-content">
            <div class="section-card">
                <div class="section-header">
                    <h2 class="section-title">Manage Events & Sessions</h2>
                </div>

                <div class="events-grid" style="margin-bottom: 32px;">
                    <% events.forEach(function(ev) { %>
                    <div class="event-admin-card">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                <span style="font-size: 11px; color: var(--text-secondary); font-weight: 700;">EVENT <%= ev.event_number %></span>
