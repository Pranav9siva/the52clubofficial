<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | The 52 Club</title>
    <link rel="icon" href="/static/club/logo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #0a0a0a;
            --bg-card: #121212;
            --bg-input: #1a1a1a;
            --border-color: #242424;
            --text-primary: #ffffff;
            --text-secondary: #8a8a8a;
            --accent-green: #10b981;
            --accent-amber: #f59e0b;
            --accent-red: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            padding-bottom: 60px;
        }

        /* Top Header */
        .admin-header {
            background: #000000;
            border-bottom: 1px solid var(--border-color);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .header-logo {
            height: 36px;
            width: auto;
        }

        .header-title-group h1 {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .header-badge {
            font-size: 11px;
            padding: 2px 8px;
            border-radius: 999px;
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
            font-weight: 700;
            display: inline-block;
            margin-left: 8px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-view-site {
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-view-site:hover {
            border-color: #666666;
            background: #181818;
        }

        .btn-logout {
            background: #1a1a1a;
            color: #aaaaaa;
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-logout:hover {
            color: #ffffff;
            background: #222222;
        }

        /* Container */
        .admin-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 32px 24px;
        }

        /* Flash Message */
        .toast-msg {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid var(--accent-green);
            color: #a7f3d0;
            padding: 14px 20px;
            border-radius: 10px;
            margin-bottom: 24px;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .toast-error {
            background: rgba(239, 68, 68, 0.15);
            border-color: #ef4444;
            color: #fca5a5;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 24px;
        }

        .stat-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: var(--text-primary);
        }

        .stat-sub {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* Navigation Tabs */
        .admin-nav-tabs {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 28px;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 700;
            padding: 12px 20px;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .tab-btn:hover {
            color: var(--text-primary);
        }

        .tab-btn.active {
            color: var(--text-primary);
            border-bottom-color: #ffffff;
        }

        /* Card Section */
        .section-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 28px;
            margin-bottom: 32px;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .section-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        /* Controls: Search, Filter, Buttons */
        .search-input {
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 13px;
            outline: none;
            width: 240px;
            transition: border-color 0.2s ease;
        }

        .search-input:focus {
            border-color: #ffffff;
        }

        .btn-action {
            background: #ffffff;
            color: #000000;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: opacity 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-action:hover {
            opacity: 0.9;
        }

        .btn-secondary {
            background: #1e1e1e;
            color: #ffffff;
            border: 1px solid var(--border-color);
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-secondary:hover {
            background: #282828;
            border-color: #555555;
        }

        /* Table */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 13px;
        }

        .data-table th {
            background: #161616;
            padding: 14px 16px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }

        .data-table td {
            padding: 16px;
            border-bottom: 1px solid var(--border-color);
            vertical-align: middle;
        }

        .data-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .member-name {
            font-weight: 700;
            color: #ffffff;
        }

        .member-meta {
            font-size: 12px;
            color: var(--text-secondary);
        }

        /* Badges */
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-badge.paid {
            background: rgba(16, 185, 129, 0.15);
            color: var(--accent-green);
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .status-badge.pending {
            background: rgba(245, 158, 11, 0.15);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* Table Action Buttons */
        .btn-table-toggle {
            background: transparent;
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-table-toggle:hover {
            background: #222222;
            border-color: #666666;
        }

        .btn-table-delete {
            background: transparent;
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-left: 6px;
        }

        .btn-table-delete:hover {
            background: rgba(239, 68, 68, 0.2);
            border-color: var(--accent-red);
        }

        .btn-table-edit {
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.35);
            color: #93c5fd;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-right: 6px;
        }

        .btn-table-edit:hover {
            background: rgba(59, 130, 246, 0.25);
            border-color: #60a5fa;
            color: #ffffff;
        }

        /* Collaborations styling */
        .collab-admin-card {
            background: #161616;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 18px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .collab-cat-pill {
            display: inline-block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #93c5fd;
            background: rgba(59, 130, 246, 0.12);
            border: 1px solid rgba(59, 130, 246, 0.25);
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 8px;
            align-self: flex-start;
        }

        /* Modal Overlays */
        .modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 20px;
            box-sizing: border-box;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-card {
            background: #141414;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            width: 100%;
            max-width: 620px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7);
            padding: 24px;
            box-sizing: border-box;
            animation: modalFadeIn 0.2s ease-out;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 14px;
        }

        .modal-title {
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #ffffff;
            margin: 0;
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--text-secondary);
            font-size: 22px;
            cursor: pointer;
            line-height: 1;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s ease;
        }

        .modal-close:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.1);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid var(--border-color);
        }

        .btn-modal-cancel {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 10px 18px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-modal-cancel:hover {
            color: #ffffff;
            border-color: #666;
            background: #222;
        }

        /* Forms in Settings & Modals */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .form-input-box {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border-color);
            color: #ffffff;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .form-input-box:focus {
            border-color: #ffffff;
        }

        .form-hint {
            font-size: 11px;
            color: #666666;
            margin-top: 6px;
        }

        /* Cards for Events & Gallery */
        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 20px;
        }

        .event-admin-card {
            background: #161616;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .event-admin-title {
            font-size: 15px;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .event-admin-detail {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Gallery Upload & Dropzone */
        .upload-dropzone {
            border: 2px dashed rgba(255, 255, 255, 0.22);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.02);
            padding: 38px 24px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 20px;
            user-select: none;
        }

        .upload-dropzone:hover,
        .upload-dropzone.drag-over {
            border-color: #ffffff;
            background: rgba(255, 255, 255, 0.06);
            box-shadow: 0 0 24px rgba(255, 255, 255, 0.05);
        }

        .upload-dropzone.drag-over {
            transform: scale(1.008);
        }

        .dropzone-icon {
            width: 44px;
            height: 44px;
            margin-bottom: 12px;
            color: #ffffff;
            opacity: 0.9;
        }

        .dropzone-title {
            font-size: 15px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .dropzone-sub {
            font-size: 12px;
            color: var(--text-secondary);
            max-width: 460px;
            line-height: 1.5;
            margin-bottom: 16px;
        }

        .btn-browse {
            background: #222222;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            padding: 9px 18px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            pointer-events: none;
            transition: all 0.2s ease;
        }

        .upload-dropzone:hover .btn-browse {
            background: #ffffff;
            color: #000000;
        }

        /* Staged previews */
        .staged-files-container {
            background: #141414;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            display: none;
        }

        .staged-files-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }

        .staged-file-card {
            background: #1b1b1b;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .staged-file-thumb {
            width: 100%;
            height: 130px;
            object-fit: cover;
            background: #000000;
        }

        .staged-file-info {
            padding: 8px 10px;
        }

        .staged-file-name {
            font-size: 11px;
            font-weight: 700;
            color: #ffffff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .staged-file-size {
            font-size: 10px;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        .staged-file-remove {
            position: absolute;
            top: 6px;
            right: 6px;
            background: rgba(0, 0, 0, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .staged-file-remove:hover {
            background: #dc2626;
            border-color: #dc2626;
        }

        @media (max-width: 768px) {
            .admin-header {
                padding: 14px 18px;
            }
            .admin-container {
                padding: 20px 14px;
            }
            .search-input {
                width: 100%;
            }
            .section-actions {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="admin-header">
        <div class="header-left">
            <img src="/static/club/logo.png" alt="The 52 Club" class="header-logo">
            <div class="header-title-group">
                <h1>The 52 Club <span class="header-badge">Admin</span></h1>
            </div>
        </div>
        <div class="header-right">
            <a href="/" target="_blank" class="btn-view-site">View Website</a>
            <form action="/admin/logout" method="POST" style="margin: 0;" onsubmit="localStorage.removeItem('the52_admin_auth'); sessionStorage.removeItem('the52_admin_auth');">
                <button type="submit" class="btn-logout">Sign Out</button>
            </form>
        </div>
    </header>

    <main class="admin-container">

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="toast-msg">
                <span><%= success %></span>
                <span style="cursor: pointer;" onclick="this.parentElement.remove()">✕</span>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="toast-msg toast-error">
                <span><%= error %></span>
                <span style="cursor: pointer;" onclick="this.parentElement.remove()">✕</span>
            </div>
        <% } %>

        <!-- Stats Overview -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total Registrations</div>
                <div class="stat-value"><%= stats.totalMembers %></div>
                <div class="stat-sub"><%= stats.paidCount %> verified, <%= stats.pendingCount %> pending</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Revenue Collected</div>
                <div class="stat-value">₹<%= stats.totalRevenue %></div>
                <div class="stat-sub">Based on ₹<%= settings.registration_fee %>/member</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Pending Payments</div>
                <div class="stat-value" style="color: var(--accent-amber);"><%= stats.pendingCount %></div>
                <div class="stat-sub">Awaiting verification</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Events</div>
                <div class="stat-value"><%= events.length %></div>
                <div class="stat-sub">Platform sessions</div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="admin-nav-tabs">
            <button class="tab-btn active" onclick="switchTab('tab-members')">Registrations (<%= stats.totalMembers %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-events')">Current Event</button>
            <a href="/admin/past-events?auth=1" class="tab-btn" style="text-decoration: none; color: inherit; display: inline-flex; align-items: center; gap: 6px;">Past Events (<%= (typeof past_events !== 'undefined' ? past_events.length : 0) %>) ➔</a>
            <button class="tab-btn" onclick="switchTab('tab-collaborations')">Collaborations (<%= (typeof collaborators !== 'undefined' ? collaborators.length : 0) %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-gallery')">Gallery (<%= (typeof gallery_images !== 'undefined' ? gallery_images.length : 0) %>)</button>
            <button class="tab-btn" onclick="switchTab('tab-settings')">Pricing & Payments</button>
        </div>

        <!-- TAB 1: MEMBERS / REGISTRATIONS -->
        <div id="tab-members" class="tab-content active">
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Registered Members</h2>
                    </div>
                    <div class="section-actions">
                        <input type="text" id="memberSearch" class="search-input" placeholder="Search name, email, phone..." oninput="filterMembers()">
                        <select id="statusFilter" class="search-input" style="width: auto;" onchange="filterMembers()">
                            <option value="all">All Statuses</option>
                            <option value="completed">Completed / Paid</option>
                            <option value="pending">Pending</option>
                        </select>
                        <a href="/admin/export-csv" class="btn-action">Export CSV</a>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="membersTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Member</th>
                                <th>Phone</th>
                                <th>Level</th>
                                <th>Payment</th>
                                <th>Txn / Order ID</th>
                                <th>Registered</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (members.length === 0) { %>
                                <tr>
                                    <td colspan="8" style="text-align: center; color: var(--text-secondary); padding: 36px;">
                                        No registrations recorded yet.
                                    </td>
                                </tr>
                            <% } else { %>
                                <% members.forEach(function(m, idx) { %>
                                <tr class="member-row" data-name="<%= (m.full_name || '').toLowerCase() %>" data-email="<%= (m.email || '').toLowerCase() %>" data-phone="<%= m.phone || '' %>" data-status="<%= m.payment_status %>">
                                    <td style="color: var(--text-secondary); font-weight: 700;"><%= idx + 1 %></td>
                                    <td>
                                        <div class="member-name"><%= m.full_name %></div>
                                        <div class="member-meta"><%= m.email %></div>
                                        <% if (m.message) { %>
                                            <div class="member-meta" style="font-style: italic; color: #aaaaaa; margin-top: 2px;">"<%= m.message %>"</div>
                                        <% } %>
                                    </td>
                                    <td><%= m.phone %></td>
                                    <td style="text-transform: capitalize; color: #cccccc;"><%= m.experience || 'beginner' %></td>
                                    <td>
                                        <% if (m.payment_status === 'completed') { %>
                                            <span class="status-badge paid">PAID</span>
                                        <% } else { %>
                                            <span class="status-badge pending">PENDING</span>
                                        <% } %>
                                    </td>
                                    <td style="font-family: monospace; font-size: 11px; color: #888888;">
                                        <%= (m.transaction_id || '').slice(0, 16) %>...
                                        <% if (m.razorpay_payment_id) { %>
                                            <div style="color: #666666;"><%= m.razorpay_payment_id %></div>
                                        <% } %>
                                    </td>
                                    <td style="font-size: 12px; color: var(--text-secondary);">
                                        <%= m.registered_at ? new Date(m.registered_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Recent' %>
                                    </td>
                                    <td style="text-align: right; white-space: nowrap;">
                                        <button type="button" class="btn-table-edit"
                                            data-id="<%= m.id %>"
                                            data-name="<%= m.full_name || '' %>"
                                            data-email="<%= m.email || '' %>"
                                            data-phone="<%= m.phone || '' %>"
                                            data-experience="<%= m.experience || 'beginner' %>"
                                            data-status="<%= m.payment_status %>"
                                            data-message="<%= m.message || '' %>"
                                            onclick="openEditMember(this)">Edit</button>
                                        <form action="/admin/members/<%= m.id %>/toggle-payment?auth=1" method="POST" style="display: inline;">
                                            <input type="hidden" name="auth" value="1">
                                            <button type="submit" class="btn-table-toggle" title="Toggle status">
                                                <%= m.payment_status === 'completed' ? 'Mark Pending' : 'Mark Paid' %>
                                            </button>
                                        </form>
                                        <form id="delete-member-<%= m.id %>" action="/admin/members/<%= m.id %>/delete?auth=1" method="POST" style="display: inline;">
                                            <input type="hidden" name="auth" value="1">
                                            <button type="button" class="btn-table-delete" title="Delete member"
                                                data-form-id="delete-member-<%= m.id %>"
                                                data-name="<%= m.full_name || 'Member #' + m.id %>"
                                                onclick="triggerMemberDelete(this)">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: CURRENT EVENT ONLY -->
        <div id="tab-events" class="tab-content">
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Current Event & Session</h2>
                        <p class="section-subtitle">
                            Only the current event is displayed on the main website homepage. Edit its details directly below.
                        </p>
                    </div>
                    <% if (typeof current_event !== 'undefined' && current_event) { %>
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        <span class="status-badge paid" style="font-size: 11px; padding: 4px 10px;">
                            ● ACTIVE HOMEPAGE EVENT
                        </span>
                        <a href="/#events" target="_blank" class="btn-table-edit" style="text-decoration: none;">
                            Preview on Home ↗
                        </a>
                    </div>
                    <% } %>
                </div>

                <% const cur = (typeof current_event !== 'undefined' && current_event) ? current_event : null; %>
                <% if (cur) { %>
                <form action="/admin/events/<%= cur.id %>/edit?auth=1" method="POST">
                    <input type="hidden" name="auth" value="1">
                    <input type="hidden" name="is_current" value="true">
                    
                    <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 22px; margin-bottom: 24px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                            <span style="font-size: 12px; font-weight: 800; letter-spacing: 1px; color: var(--text-secondary);">
                                EDITING EVENT #<%= cur.event_number || '02' %>: <%= cur.title %>
                            </span>
                            <span style="font-size: 11px; color: #10b981; font-weight: 700; background: rgba(16,185,129,0.1); padding: 2px 8px; border-radius: 4px;">
                                HOMEPAGE CURRENT
                            </span>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label class="form-label">Event Number</label>
                                <input type="text" name="event_number" class="form-input-box" value="<%= cur.event_number || '' %>" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Title / Challenge Name</label>
                                <input type="text" name="title" class="form-input-box" value="<%= cur.title || '' %>" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Date & Time Text</label>
                                <input type="text" name="date_text" class="form-input-box" value="<%= cur.date_text || '' %>" placeholder="e.g. SUNDAY, 30TH AUGUST · 6:00 AM">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Venue Location</label>
                                <input type="text" name="venue" class="form-input-box" value="<%= cur.venue || '' %>" placeholder="e.g. STONES FITNESS STUDIO, ANANTAPUR.">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Members / Challengers Text</label>
                                <input type="text" name="members" class="form-input-box" value="<%= cur.Challengers || cur.members || '' %>" placeholder="e.g. 52 MEMBERS or 7 Finishes">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Collaborations / Partners Text</label>
                                <input type="text" name="collaborations" class="form-input-box" value="<%= cur.collaborations || '' %>" placeholder="e.g. BVR Karthik, Stones Fitness Studio, V Mr. Health.">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Tags (comma separated)</label>
                                <input type="text" name="tags" class="form-input-box" value="<%= cur.tags || '' %>" placeholder="RUNNING, CHALLENGE">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Google Drive Photos Folder Link</label>
                                <input type="url" name="google_drive_link" class="form-input-box" value="<%= cur.google_drive_link || '' %>" placeholder="https://drive.google.com/...">
                            </div>
                            <div class="form-group">
                                <label class="form-label">Homepage Visibility</label>
                                <select name="is_active" class="form-input-box">
                                    <option value="true" <%= cur.is_active ? 'selected' : '' %>>Active (Visible on Homepage)</option>
                                    <option value="false" <%= !cur.is_active ? 'selected' : '' %>>Hidden (Draft)</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group" style="margin-top: 16px;">
                            <label class="form-label">Description / Workout Brief</label>
                            <textarea name="description" class="form-input-box" rows="3" placeholder="Brief overview of the upcoming session..."><%= cur.description || '' %></textarea>
                        </div>

                        <div style="margin-top: 22px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                            <button type="submit" class="btn-action">SAVE CURRENT EVENT CHANGES</button>
                            <% if (cur.google_drive_link) { %>
                                <a href="<%= cur.google_drive_link %>" target="_blank" class="btn-header-link">Open Drive Folder ↗</a>
                            <% } %>
                        </div>
                    </div>
                </form>
                <% } else { %>
                <div style="text-align: center; padding: 48px 24px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; margin-bottom: 24px;">
                    <p style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 8px;">NO CURRENT EVENT SET</p>
                    <p style="font-size: 13px; color: var(--text-secondary); max-width: 480px; margin: 0 auto 18px;">
                        Select an event from the Past Events page to make it the active current event on the home page.
                    </p>
                    <a href="/admin/past-events?auth=1" class="btn-action">Go to Past Events Page ➔</a>
                </div>
                <% } %>

                <!-- Redirect Button to Separate Page for Past Events at End of Section -->
                <div style="margin-top: 36px; padding: 24px; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                            <span style="font-size: 18px;">📁</span>
                            <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; letter-spacing: -0.3px; margin: 0;">PAST EVENTS & ARCHIVE</h3>
                        </div>
                        <p style="font-size: 13px; color: var(--text-secondary); margin: 0; max-width: 580px; line-height: 1.5;">
                            Manage past event archives, challenger finisher counts, sponsor collaborations, and photo folders on the dedicated Past Events page.
                        </p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
                        <a href="/past-events" target="_blank" class="btn-header-link" style="padding: 12px 18px; font-size: 12px;">
                            Public Archive ↗
                        </a>
                        <a href="/admin/past-events?auth=1" id="managePastEventsRedirectBtn" class="btn-action" style="padding: 12px 22px; font-size: 13px; text-decoration: none;">
                            <span>MANAGE PAST EVENTS PAGE</span>
                            <span>➔</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: COLLABORATIONS -->
        <div id="tab-collaborations" class="tab-content">
            <div class="section-card">
                <div class="section-header">
                    <h2 class="section-title">Manage Collaborations & Partners</h2>
                </div>

                <div class="events-grid" style="margin-bottom: 32px;">
                    <% if (typeof collaborators === 'undefined' || collaborators.length === 0) { %>
                        <div style="color: var(--text-secondary); padding: 24px;">No collaborators added yet.</div>
                    <% } else { %>
                        <% collaborators.forEach(function(c) { %>
                        <div class="collab-admin-card">
                            <div>
                                <span class="collab-cat-pill"><%= c.category %></span>
                                <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; margin-bottom: 6px;"><%= c.name %></h3>
                                <% if (c.url) { %>
                                    <p class="event-admin-detail"><strong>URL:</strong> <a href="<%= c.url %>" target="_blank" style="color: #60a5fa;"><%= c.url %></a></p>
                                <% } %>
                                <p class="event-admin-detail"><strong>Order:</strong> <%= c.order || 0 %> &nbsp;|&nbsp; <strong>Status:</strong> <%= c.is_active ? 'Active' : 'Hidden' %></p>
                            </div>
                            <div style="margin-top: 16px; display: flex; gap: 8px; flex-wrap: wrap;">
                                <button type="button" class="btn-table-edit"
                                    data-id="<%= c.id %>"
                                    data-name="<%= c.name || '' %>"
                                    data-category="<%= c.category || '' %>"
                                    data-url="<%= c.url || '' %>"
                                    data-order="<%= c.order || 0 %>"
                                    data-active="<%= c.is_active ? 'true' : 'false' %>"
                                    onclick="openEditCollab(this)">Edit</button>
                                <form action="/admin/collaborators/<%= c.id %>/toggle?auth=1" method="POST" style="display: inline;">
                                    <input type="hidden" name="auth" value="1">
                                    <button type="submit" class="btn-table-toggle"><%= c.is_active ? 'Hide' : 'Show' %></button>
                                </form>
                                <form id="delete-collab-<%= c.id %>" action="/admin/collaborators/<%= c.id %>/delete?auth=1" method="POST" style="display: inline;">
                                    <input type="hidden" name="auth" value="1">
                                    <button type="button" class="btn-table-delete"
                                        data-form-id="delete-collab-<%= c.id %>"
                                        data-name="<%= c.name || 'this partner' %>"
                                        onclick="triggerCollabDelete(this)">Delete</button>
                                </form>
                            </div>
                        </div>
                        <% }); %>
                    <% } %>
                </div>

                <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 16px; text-transform: uppercase;">Add New Collaborator</h3>
                <form action="/admin/collaborators/add?auth=1" method="POST">
                    <input type="hidden" name="auth" value="1">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Brand / Partner Name</label>
                            <input type="text" name="name" class="form-input-box" placeholder="e.g. RedBull, Cult.fit, Eden Gardens" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <input type="text" name="category" class="form-input-box" placeholder="e.g. VENUE PARTNERS, FITNESS PARTNERS, ENERGY PARTNERS" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Website / Social URL</label>
                            <input type="url" name="url" class="form-input-box" placeholder="https://...">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Display Order</label>
                            <input type="number" name="order" class="form-input-box" placeholder="1, 2, 3..." value="<%= (typeof collaborators !== 'undefined' ? collaborators.length + 1 : 1) %>">
                        </div>
                    </div>
                    <button type="submit" class="btn-action">Add Collaborator</button>
                </form>
            </div>
        </div>

        <!-- TAB 4: GALLERY -->
        <div id="tab-gallery" class="tab-content">
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="section-title">Gallery Photos (<%= (typeof gallery_images !== 'undefined' ? gallery_images.length : 0) %>)</h2>
                        <p style="font-size: 12px; color: var(--text-secondary); margin-top: 4px;">Upload community, run, and workout photos to display on the public website homepage.</p>
                    </div>
                </div>

                <!-- Existing Gallery Grid -->
                <div class="events-grid" style="margin-bottom: 36px;">
                    <% if (typeof gallery_images === 'undefined' || gallery_images.length === 0) { %>
                    <div style="grid-column: 1 / -1; padding: 40px 20px; text-align: center; border: 1px dashed var(--border-color); border-radius: 10px; background: rgba(255,255,255,0.01);">
                        <div style="font-size: 32px; margin-bottom: 10px;">📸</div>
                        <h4 style="font-size: 14px; font-weight: 800; color: #ffffff; text-transform: uppercase; margin-bottom: 6px;">No Gallery Photos Yet</h4>
                        <p style="font-size: 12px; color: var(--text-secondary);">Upload photos from your device using the upload section below.</p>
                    </div>
                    <% } else { %>
                    <% gallery_images.forEach(function(g) { %>
                    <div class="event-admin-card" id="gallery-card-<%= g.id %>">
                        <div>
                            <div style="position: relative; width: 100%; height: 180px; border-radius: 8px; overflow: hidden; margin-bottom: 12px; background: #0a0a0a;">
                                <img src="<%= g.image %>" alt="<%= g.caption || 'The 52 Club Photo' %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null; this.src='/static/club/logo.png'; this.style.objectFit='contain'; this.style.padding='24px';">
                                <span style="position: absolute; top: 8px; left: 8px; font-size: 10px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; background: <%= g.is_visible ? 'rgba(16, 185, 129, 0.9)' : 'rgba(75, 85, 99, 0.9)' %>; color: #ffffff;">
                                    <%= g.is_visible ? 'Visible' : 'Hidden' %>
                                </span>
                            </div>
                            <h4 style="font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 6px;"><%= g.caption || 'The 52 Club' %></h4>
                            <p class="event-admin-detail" style="font-size: 11px; word-break: break-all; opacity: 0.75;">
                                <code><%= g.image %></code>
                            </p>
                        </div>
                        <div style="margin-top: 14px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
                            <form action="/admin/gallery/<%= g.id %>/toggle?auth=1" method="POST" style="display: inline; margin: 0;">
                                <input type="hidden" name="auth" value="1">
                                <button type="submit" class="btn-table-toggle"><%= g.is_visible ? 'Hide' : 'Show' %></button>
                            </form>
                            <button type="button" class="btn-table-edit"
                                data-id="<%= g.id %>"
                                data-caption="<%= g.caption || '' %>"
                                data-image="<%= g.image %>"
                                data-order="<%= g.order !== undefined ? g.order : 0 %>"
                                data-visible="<%= g.is_visible ? 'true' : 'false' %>"
                                onclick="openEditGallery(this)">Edit Caption</button>
                            <form id="delete-gallery-<%= g.id %>" action="/admin/gallery/<%= g.id %>/delete?auth=1" method="POST" style="display: inline; margin: 0;">
                                <input type="hidden" name="auth" value="1">
                                <button type="button" class="btn-table-delete"
                                    data-form-id="delete-gallery-<%= g.id %>"
                                    data-caption="<%= g.caption || 'this photo' %>"
                                    onclick="triggerGalleryDelete(this)">Delete</button>
                            </form>
                        </div>
                    </div>
                    <% }); %>
                    <% } %>
                </div>

                <!-- Upload Section (Direct File Uploads) -->
                <div style="border-top: 1px solid var(--border-color); padding-top: 28px;">
                    <h3 style="font-size: 16px; font-weight: 800; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">+ Upload Photos</h3>
                    <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 20px;">Upload one or more photos directly from your device. No URLs needed — photos are saved securely on your server.</p>

                    <form id="galleryUploadForm" action="/admin/gallery/upload?auth=1" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="auth" value="1">

                        <!-- Drag and Drop Dropzone -->
                        <div id="galleryDropzone" class="upload-dropzone">
                            <svg class="dropzone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                <polyline points="21 15 16 10 5 21"></polyline>
                            </svg>
                            <div class="dropzone-title">DRAG & DROP PHOTOS HERE, OR CLICK TO BROWSE</div>
                            <div class="dropzone-sub">Supports JPG, JPEG, PNG, WEBP, GIF, AVIF (up to 15MB each). You can select multiple photos at once.</div>
                            <button type="button" class="btn-browse">Browse Photos on Device</button>
                            <input type="file" id="galleryFileInput" name="photos" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" multiple style="display: none;">
                        </div>

                        <!-- Staged Previews Container (Shows selected photos before upload) -->
                        <div id="stagedFilesContainer" class="staged-files-container">
                            <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                                <div style="font-size: 13px; font-weight: 800; color: #ffffff;" id="stagedFilesCount">0 Photos Selected</div>
                                <button type="button" id="clearStagedBtn" class="btn-modal-cancel" style="padding: 6px 12px; font-size: 11px;">Clear Selection</button>
                            </div>

                            <div id="stagedFilesGrid" class="staged-files-grid"></div>

                            <div class="form-group" style="margin-top: 20px; margin-bottom: 0;">
                                <label class="form-label">Photo Caption (Optional)</label>
                                <input type="text" id="galleryBatchCaption" name="caption" class="form-input-box" placeholder="e.g. Sunday Morning Run, Stones Fitness Studio Workout...">
                                <div class="form-hint">Applied to uploaded photos in this batch. You can also edit individual captions anytime after upload.</div>
                            </div>

                            <div style="margin-top: 20px;">
                                <button type="submit" id="galleryUploadSubmitBtn" class="btn-action" style="padding: 12px 28px; font-size: 13px; font-weight: 800;">
                                    <span id="uploadBtnText">UPLOAD PHOTOS TO GALLERY NOW</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 5: SETTINGS -->
        <div id="tab-settings" class="tab-content">
            <div class="section-card">
                <div class="section-header">
                    <h2 class="section-title">Pricing & Gateway Settings</h2>
                </div>

                <form action="/admin/settings/update?auth=1" method="POST">
                    <input type="hidden" name="auth" value="1">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label">Registration Fee (₹ INR)</label>
                            <input type="number" step="1" name="registration_fee" class="form-input-box" value="<%= settings.registration_fee %>" required>
                            <div class="form-hint">The fee charged during member registration.</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">UPI ID</label>
                            <input type="text" name="upi_id" class="form-input-box" value="<%= settings.upi_id || '' %>">
                            <div class="form-hint">UPI VPA used to generate QR code and direct links (optional).</div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">UPI Display Name</label>
                            <input type="text" name="upi_display_name" class="form-input-box" value="<%= settings.upi_display_name || '' %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Razorpay Key ID</label>
                            <input type="text" name="razorpay_key_id" class="form-input-box" value="<%= settings.razorpay_key_id %>">
                            <div class="form-hint">Starts with <code>rzp_test_</code> or <code>rzp_live_</code></div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Razorpay Key Secret</label>
                            <input type="password" name="razorpay_key_secret" class="form-input-box" value="<%= settings.razorpay_key_secret %>">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Webhook Secret</label>
                            <input type="password" name="webhook_secret" class="form-input-box" value="<%= settings.webhook_secret %>">
                        </div>
                    </div>

                    <button type="submit" class="btn-action" style="margin-top: 10px;">Save Changes</button>
                </form>
            </div>
        </div>

    </main>

    <!-- MODAL: EDIT MEMBER -->
    <div id="editMemberModal" class="modal-backdrop" onclick="handleBackdropClick(event, 'editMemberModal')">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="modal-title">Edit Member Registration</h3>
