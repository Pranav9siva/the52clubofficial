                                <p class="event-admin-detail"><strong>Tags:</strong> <%= ev.tags %></p>
                            <% } %>
                            <p class="event-admin-detail"><strong>Drive Link:</strong> <a href="<%= ev.google_drive_link %>" target="_blank" style="color: #60a5fa;"><%= ev.google_drive_link || 'None' %></a></p>
