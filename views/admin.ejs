                                data-title="<%= ev.title || '' %>"
                                data-date="<%= ev.date_text || '' %>"
                                data-venue="<%= ev.venue || '' %>"
                                data-tags="<%= ev.tags || '' %>"
                                data-drive="<%= ev.google_drive_link || '' %>"
                                data-members="<%= ev.members || '52 MEMBERS' %>"
                                data-collabs="<%= ev.collaborations || '' %>"
                                data-desc="<%= ev.description || '' %>"
