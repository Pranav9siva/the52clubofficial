    <!-- MODAL: CONFIRM DELETE (In-page modal replacing blocked window.confirm) -->
    <div id="confirmDeleteModal" class="modal-backdrop" onclick="handleBackdropClick(event, 'confirmDeleteModal')">
        <div class="modal-card" style="max-width: 440px;" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3 class="modal-title" id="confirmDeleteTitle" style="color: #ef4444; font-size: 16px; font-weight: 800;">Confirm Deletion</h3>
                <button type="button" class="modal-close" onclick="closeModal('confirmDeleteModal')">&times;</button>
            </div>
            <div style="padding: 22px 24px; color: var(--text-secondary); font-size: 14px; line-height: 1.6;" id="confirmDeleteMessage">
                Are you sure you want to permanently delete this item? This action cannot be undone.
            </div>
            <div class="modal-footer" style="padding: 16px 24px; background: #0c0c0c; display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn-modal-cancel" onclick="closeModal('confirmDeleteModal')">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn-table-delete" style="padding: 9px 18px; font-size: 13px; font-weight: 800; text-transform: uppercase;">Delete Permanently</button>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tabId) {
            if (!tabId) return;
            const targetId = tabId.startsWith('tab-') ? tabId : ('tab-' + tabId);

            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

            const activeBtn = Array.from(document.querySelectorAll('.tab-btn')).find(b => {
                const clickAttr = b.getAttribute('onclick') || '';
                return clickAttr.includes("'" + targetId + "'") || clickAttr.includes("'" + tabId + "'");
            });
            if (activeBtn) activeBtn.classList.add('active');

            const targetContent = document.getElementById(targetId);
            if (targetContent) targetContent.classList.add('active');

            try {
                localStorage.setItem('the52_admin_tab', targetId);
            } catch (e) {}
        }

        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam) {
                switchTab(tabParam);
            } else {
                try {
                    const saved = localStorage.getItem('the52_admin_tab');
                    if (saved && document.getElementById(saved)) {
                        switchTab(saved);
                    }
                } catch (e) {}
            }
        });

        function filterMembers() {
            const query = (document.getElementById('memberSearch').value || '').toLowerCase().trim();
            const status = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('#membersTable tbody tr.member-row');

            rows.forEach(row => {
                const name = row.dataset.name || '';
                const email = row.dataset.email || '';
                const phone = row.dataset.phone || '';
                const rowStatus = row.dataset.status || '';

                const matchesQuery = !query || name.includes(query) || email.includes(query) || phone.includes(query);
                const matchesStatus = status === 'all' || rowStatus === status;

                if (matchesQuery && matchesStatus) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        let targetDeleteFormId = null;

        function confirmDelete(formId, title, message) {
            targetDeleteFormId = formId;
            const titleEl = document.getElementById('confirmDeleteTitle');
            const msgEl = document.getElementById('confirmDeleteMessage');
            const modalEl = document.getElementById('confirmDeleteModal');
            if (titleEl) titleEl.textContent = title || 'Confirm Deletion';
            if (msgEl) msgEl.textContent = message || 'Are you sure you want to delete this item? This action cannot be undone.';
            if (modalEl) modalEl.classList.add('open');
        }

        function triggerMemberDelete(btn) {
            const formId = btn.dataset.formId;
            const name = btn.dataset.name || 'this member';
            confirmDelete(formId, 'Remove Registration', 'Are you sure you want to permanently remove registration for ' + name + '?');
        }

        function triggerEventDelete(btn) {
            const formId = btn.dataset.formId;
            const title = btn.dataset.title || 'this event';
            confirmDelete(formId, 'Delete Event', 'Are you sure you want to permanently delete event: ' + title + '?');
        }

        function triggerCollabDelete(btn) {
            const formId = btn.dataset.formId;
            const name = btn.dataset.name || 'this partner';
            confirmDelete(formId, 'Delete Partner', 'Are you sure you want to delete partner: ' + name + '?');
        }

        function triggerGalleryDelete(btn) {
            const formId = btn.dataset.formId;
            const caption = btn.dataset.caption || 'this image';
            confirmDelete(formId, 'Delete Gallery Image', 'Are you sure you want to delete gallery photo: ' + caption + '?');
        }

        document.getElementById('confirmDeleteBtn')?.addEventListener('click', function() {
            if (targetDeleteFormId) {
                const form = document.getElementById(targetDeleteFormId);
                if (form) {
                    form.submit();
                }
            }
        });

        function openEditMember(btn) {
            const ds = btn.dataset;
            openEditMemberModal(ds.id, ds.name, ds.email, ds.phone, ds.experience, ds.status, ds.message);
        }

        function openEditEvent(btn) {
            const ds = btn.dataset;
            openEditEventModal(ds.id, ds.number, ds.title, ds.date, ds.venue, ds.tags, ds.drive, ds.members, ds.collabs, ds.desc, ds.active === 'true');
        }

        function openEditCollab(btn) {
            const ds = btn.dataset;
            openEditCollabModal(ds.id, ds.name, ds.category, ds.url, ds.order, ds.active === 'true');
        }

        function openEditMemberModal(id, name, email, phone, experience, status, message) {
            document.getElementById('editMemberForm').action = '/admin/members/' + id + '/edit?auth=1';
            document.getElementById('editMemberName').value = name || '';
            document.getElementById('editMemberEmail').value = email || '';
            document.getElementById('editMemberPhone').value = phone || '';
            document.getElementById('editMemberExperience').value = experience || 'beginner';
            document.getElementById('editMemberStatus').value = status || 'pending';
            document.getElementById('editMemberMessage').value = message || '';
            document.getElementById('editMemberModal').classList.add('open');
        }

        function openEditEventModal(id, num, title, date, venue, tags, drive, members, collabs, desc, isActive) {
            document.getElementById('editEventForm').action = '/admin/events/' + id + '/edit?auth=1';
            document.getElementById('editEventNumber').value = num || '';
            document.getElementById('editEventTitle').value = title || '';
            document.getElementById('editEventDate').value = date || '';
            document.getElementById('editEventVenue').value = venue || '';
            document.getElementById('editEventTags').value = tags || '';
            document.getElementById('editEventDrive').value = drive || '';
            document.getElementById('editEventMembers').value = (members !== undefined && members !== null) ? members : '';
            document.getElementById('editEventCollaborations').value = collabs || '';
            document.getElementById('editEventDescription').value = desc || '';
            document.getElementById('editEventIsActive').value = isActive ? 'true' : 'false';
            document.getElementById('editEventModal').classList.add('open');
        }

        function openEditCollabModal(id, name, category, url, order, isActive) {
            document.getElementById('editCollabForm').action = '/admin/collaborators/' + id + '/edit?auth=1';
            document.getElementById('editCollabName').value = name || '';
            document.getElementById('editCollabCategory').value = category || '';
            document.getElementById('editCollabUrl').value = url || '';
            document.getElementById('editCollabOrder').value = order || 0;
            document.getElementById('editCollabIsActive').value = isActive ? 'true' : 'false';
            document.getElementById('editCollabModal').classList.add('open');
        }

        function closeModal(modalId) {
            const el = document.getElementById(modalId);
            if (el) el.classList.remove('open');
        }

        function handleBackdropClick(event, modalId) {
            if (event.target.id === modalId) {
                closeModal(modalId);
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal-backdrop.open').forEach(m => m.classList.remove('open'));
            }
        });
    </script>
</body>
</html>
