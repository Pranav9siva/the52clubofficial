<%- include('partials/header', {
    title: 'Payment — The 52 Club',
    extraCss: '<link rel="stylesheet" href="/static/club/payment.css">'
}) %>

<section class="payment-page">

    <div class="payment-container">

        <!-- Header -->
        <div class="payment-header">
            <div class="payment-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M9 12l2 2 4-4" />
                    <circle cx="12" cy="12" r="10" />
                </svg>
            </div>
            <h1>COMPLETE<br><span>PAYMENT</span></h1>
            <p class="payment-subtitle">
                Welcome, <strong><%= member.full_name %></strong>!<br>
                Pay securely to confirm your registration.
            </p>
            <!-- Live Status Indicator -->
            <div class="status-indicator">
                <span class="pulse-dot" id="pulseDot"></span>
                <span id="statusText">Waiting for payment...</span>
            </div>
        </div>

        <!-- Amount Card -->
        <div class="amount-card">
            <p class="amount-label">REGISTRATION FEE</p>
            <p class="amount-value">₹ <%= settings.registration_fee %></p>
        </div>

        <!-- Pay Now Button (Razorpay Checkout) -->
        <button type="button" class="confirm-btn" id="payNowBtn" onclick="openRazorpay()"
            style="background: #ffffff; color: #000000; font-size: 16px; padding: 20px 24px; margin-bottom: 20px; border-radius: 6px; cursor: pointer; border: 1px solid #ffffff; width: 100%; font-weight: 800; letter-spacing: 1px; transition: all 0.2s ease;">
            ⚡ PAY ₹<%= settings.registration_fee %> NOW
        </button>
        <p class="qr-hint" style="margin-bottom: 30px; color: #888888;">Supports UPI (GPay, PhonePe, Paytm), Cards, Netbanking & Wallets</p>

        <!-- Hidden Data -->
        <input type="hidden" id="txId" value="<%= transaction_id %>">
        <input type="hidden" id="memberId" value="<%= member.id %>">
        <input type="hidden" id="rzpOrderId" value="<%= razorpay_order_id %>">
        <input type="hidden" id="rzpKeyId" value="<%= razorpay_key_id %>">
        <input type="hidden" id="rzpAmount" value="<%= amount_in_paise %>">
        <input type="hidden" id="memberEmail" value="<%= member.email %>">
        <input type="hidden" id="memberName" value="<%= member.full_name %>">
        <input type="hidden" id="memberPhone" value="<%= member.phone %>">

    </div>

</section>

<!-- Success Modal Popup -->
<div class="payment-modal-overlay" id="successModal">
    <div class="payment-modal-card">
        <div class="modal-icon">
            <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none" />
                <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8" />
            </svg>
        </div>
        <h2 class="modal-title">PAYMENT VERIFIED!</h2>
        <p class="modal-subtitle">
            Thank you, <strong><%= member.full_name %></strong>!<br>
            Your registration is confirmed. Redirecting...
        </p>
        <a href="/payment/success/<%= member.id %>/" class="modal-action-btn">
            VIEW REGISTRATION DETAILS
        </a>
    </div>
</div>

<%- include('partials/footer', {
    extraJs: `
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
        const txId = document.getElementById('txId').value;
        const memberId = document.getElementById('memberId').value;
        let pollInterval = null;

        document.addEventListener('DOMContentLoaded', function () {
            startPaymentPolling();
        });

        async function openRazorpay() {
            const payBtn = document.getElementById('payNowBtn');
            const originalBtnText = payBtn ? payBtn.innerHTML : '';
            const statusText = document.getElementById('statusText');

            const keyId = document.getElementById('rzpKeyId').value;
            const amount = document.getElementById('rzpAmount').value;
            const email = document.getElementById('memberEmail').value;
            const name = document.getElementById('memberName').value;
            const phone = document.getElementById('memberPhone').value;

            if (payBtn) {
                payBtn.disabled = true;
                payBtn.innerHTML = '⏳ INITIALIZING CHECKOUT...';
            }
            if (statusText) statusText.textContent = 'Generating Razorpay order...';

            try {
                // STEP 1: Call Backend to Create Order
                const createRes = await fetch('/api/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: parseInt(amount, 10),
                        currency: 'INR',
                        receipt: 'rcpt_' + memberId + '_' + Date.now(),
                        transaction_id: txId,
                        member_id: memberId
                    })
                });

                const orderData = await createRes.json();
                if (!createRes.ok || !orderData.order_id) {
                    throw new Error(orderData.error || 'Failed to create payment order');
                }

                if (statusText) statusText.textContent = 'Awaiting payment authorization...';

                // STEP 2: Configure Razorpay Standard Checkout
                const options = {
                    "key": orderData.key_id || keyId,
                    "amount": orderData.amount,
                    "currency": orderData.currency || "INR",
                    "name": "The 52 Club",
                    "description": "Club Registration Fee",
                    "order_id": orderData.order_id,
                    "handler": async function (response) {
                        if (statusText) statusText.textContent = 'Verifying payment signature...';

                        try {
                            // STEP 3: Send razorpay_payment_id, razorpay_order_id, razorpay_signature to verify endpoint
                            const verifyRes = await fetch('/api/verify-payment', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    transaction_id: txId,
                                    member_id: memberId
                                })
                            });

                            const verifyData = await verifyRes.json();
                            if (verifyRes.ok && verifyData.success) {
                                triggerSuccessPopup();
                            } else {
                                const errMsg = verifyData.error || 'Signature verification failed';
                                alert('Verification failed: ' + errMsg);
                                if (statusText) statusText.textContent = 'Verification error: ' + errMsg;
                                if (payBtn) {
                                    payBtn.disabled = false;
                                    payBtn.innerHTML = originalBtnText;
                                }
                            }
                        } catch (verifyErr) {
                            console.error('Verify error:', verifyErr);
                            alert('Network error verifying payment. Please refresh or contact support.');
                            if (payBtn) {
                                payBtn.disabled = false;
                                payBtn.innerHTML = originalBtnText;
                            }
                        }
                    },
                    "prefill": {
                        "name": name,
                        "email": email,
                        "contact": phone
                    },
                    "theme": {
                        "color": "#000000"
                    },
                    "modal": {
                        "ondismiss": function () {
                            console.log('Payment modal dismissed by user');
                            if (statusText) statusText.textContent = 'Payment cancelled by user. Click below to retry.';
                            if (payBtn) {
                                payBtn.disabled = false;
                                payBtn.innerHTML = originalBtnText;
                            }
                        }
                    }
                };

                const rzp = new Razorpay(options);

                // Handle payment.failed event
                rzp.on('payment.failed', function (failedResponse) {
                    console.error('Payment failed:', failedResponse.error);
                    const desc = failedResponse.error ? failedResponse.error.description : 'Payment could not be completed';
                    alert('Payment Failed: ' + desc);
                    if (statusText) statusText.textContent = 'Payment failed: ' + desc;
                    if (payBtn) {
                        payBtn.disabled = false;
                        payBtn.innerHTML = originalBtnText;
                    }
                });

                rzp.open();
            } catch (err) {
                console.error('Checkout error:', err);
                alert('Unable to initialize checkout: ' + err.message);
                if (statusText) statusText.textContent = 'Checkout error: ' + err.message;
                if (payBtn) {
                    payBtn.disabled = false;
                    payBtn.innerHTML = originalBtnText;
                }
            }
        }

        function startPaymentPolling() {
            pollInterval = setInterval(checkStatus, 3000);
        }

        function checkStatus() {
            if (!txId) return;

            fetch('/api/payment/status/' + txId + '/')
                .then(response => response.json())
                .then(data => {
                    if (data.status === 'completed') {
                        clearInterval(pollInterval);
                        triggerSuccessPopup();
                    }
                })
                .catch(err => console.log('Poll error:', err));
        }

        function triggerSuccessPopup() {
            if (pollInterval) clearInterval(pollInterval);
            const modal = document.getElementById('successModal');
            const statusText = document.getElementById('statusText');
            const pulseDot = document.getElementById('pulseDot');

            if (statusText) statusText.textContent = 'Payment Verified!';
            if (pulseDot) pulseDot.style.background = '#ffffff';

            if (modal) modal.classList.add('active');

            setTimeout(function () {
                window.location.href = '/payment/success/' + memberId + '/';
            }, 2000);
        }
    </script>
    `
}) %>
