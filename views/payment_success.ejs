<%- include('partials/header', {
    title: 'Welcome to The 52 Club!',
    extraCss: '<link rel="stylesheet" href="/static/club/payment.css">'
}) %>

<section class="payment-page success-page">

    <div class="payment-container">

        <!-- Success Animation -->
        <div class="success-icon">
            <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark-circle" cx="26" cy="26" r="25" fill="none"/>
                <path class="checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
            </svg>
        </div>

        <h1 class="success-title">YOU'RE IN.</h1>

        <p class="success-name">
            Welcome to The 52 Club, <strong><%= member.full_name %></strong>!
        </p>

        <p class="success-message">
            Your registration and payment have been received.
            Our team will verify your payment and reach out to you soon
            with session details.
        </p>

        <div class="success-details">
            <div class="detail-item">
                <span class="detail-label">NAME</span>
                <span class="detail-value"><%= member.full_name %></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">EMAIL</span>
                <span class="detail-value"><%= member.email %></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">PHONE</span>
                <span class="detail-value"><%= member.phone %></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">EXPERIENCE</span>
                <span class="detail-value" style="text-transform: capitalize;"><%= member.experience || 'Beginner' %></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">PAYMENT STATUS</span>
                <span class="detail-value" style="color: #ffffff; background: #1a1a1a; border: 1px solid #333333; padding: 4px 10px; border-radius: 4px; text-transform: uppercase; font-weight: 700; font-size: 13px;"><%= member.payment_status || 'COMPLETED' %></span>
            </div>
        </div>

        <a href="/" class="back-home-btn">
            BACK TO HOME
        </a>

    </div>

</section>

<%- include('partials/footer') %>
