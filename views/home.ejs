<%- include('partials/header', { title: 'The 52 Club | Strength-Based Community', bodyClass: 'home-bg' }) %>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <p class="hero-small">BEYOND THE STRENGTH</p>
            <h1>
                BUILT BY<br>
                <span>STRENGTH.</span>
            </h1>
            <p class="hero-description">
                A strength-based community built around
                discipline, consistency and people.
            </p>
            <a href="#register" class="hero-btn">
                JOIN THE 52 CLUB
            </a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="section-title">
            <p>WHO WE ARE</p>
            <h2>MORE THAN<br>JUST STRENGTH.</h2>
        </div>
        <div class="about-text">
            <p>
                The 52 Club is a strength-based community
                bringing people together through weekly sessions,
                shared goals and a commitment to becoming stronger.
            </p>
            <p>
                We believe strength isn't just about what you can lift.
                It's about discipline, consistency and the people
                standing beside you.
            </p>
        </div>
    </section>

    <!-- Weekly Sessions -->
    <section class="sessions">
        <p class="section-label">EVERY WEEK</p>
        <h2>SHOW UP.<br>GET STRONGER.</h2>

        <div class="session-grid">
            <div class="session-card">
                <span>01</span>
                <h3>TRAIN</h3>
                <p>
                    Push your limits through structured
                    strength sessions.
                </p>
            </div>

            <div class="session-card">
                <span>02</span>
                <h3>CONNECT</h3>
                <p>
                    Meet people who share the same
                    drive and mindset.
                </p>
            </div>

            <div class="session-card">
                <span>03</span>
                <h3>GROW</h3>
                <p>
                    Build consistency and become
                    stronger together.
                </p>
            </div>
        </div>
    </section>

    <!-- Events -->
    <section id="events" class="events">
        <p class="section-label">WHAT'S HAPPENING</p>
        <h2>WEEKLY<br><span>SESSIONS & EVENTS</span></h2>

        <div class="events-grid-v2">
            <% if (typeof events !== 'undefined' && events.length > 0) { %>
                <% events.forEach(function(event) { %>
                <div class="event-card-v2">
                    <!-- Header: Watermark Number & Tags -->
                    <div class="event-card-top">
                        <span class="event-num-watermark"><%= event.event_number || '01' %></span>
                        <div class="event-tags-container">
                            <% const tags = (event.tags || 'RUNNING, CHALLENGE, COMMUNITY').split(','); %>
                            <% tags.forEach(function(tag) { %>
                                <% if (tag.trim()) { %>
                                <span class="event-tag-badge"><%= tag.trim() %></span>
                                <% } %>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Title & Description -->
                    <div class="event-card-body">
                        <h3 class="event-card-title">🏁 <%= event.title %></h3>
                        <% if (event.description) { %>
                        <p class="event-card-desc"><%= event.description %></p>
                        <% } %>
                    </div>

                    <!-- Banner Image if available -->
                    <% if (event.image) { %>
                    <div class="event-card-banner">
                        <img src="<%= event.image %>" alt="<%= event.title %>">
                    </div>
                    <% } %>

                    <!-- Meta Grid: Venue, Date, Members, Collaborations -->
                    <div class="event-meta-grid">
                        <div class="meta-box">
                            <span class="meta-label">VENUE</span>
                            <p class="meta-val">📍 <%= event.venue %></p>
                        </div>
                        <div class="meta-box">
                            <span class="meta-label">DATE</span>
                            <p class="meta-val">📅 <%= event.date_text %></p>
                        </div>
                        <div class="meta-box">
                            <span class="meta-label">MEMBERS</span>
                            <p class="meta-val">👥 <%= event.members || '52 MEMBERS' %></p>
                        </div>
                        <% if (event.collaborations) { %>
                        <div class="meta-box">
                            <span class="meta-label">COLLABORATIONS</span>
                            <p class="meta-val">🔥 <%= event.collaborations %></p>
                        </div>
                        <% } %>
                    </div>

                    <!-- Actions: Google Drive Link -->
                    <% if (event.google_drive_link) { %>
                    <div class="event-card-footer">
                        <a href="<%= event.google_drive_link %>" target="_blank" rel="noopener" class="drive-btn">
                            📁 VIEW PHOTOS (DRIVE)
                        </a>
                    </div>
                    <% } %>
                </div>
                <% }); %>
            <% } else { %>
                <div style="grid-column: 1 / -1; text-align: center; padding: 56px 24px; background: rgba(255,255,255,0.02); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px;">
                    <p style="font-size: 16px; font-weight: 800; color: #ffffff; letter-spacing: 1.5px; margin-bottom: 8px;">NO UPCOMING SESSIONS SCHEDULED</p>
                    <p style="font-size: 13px; color: #888888;">New training dates and challenges will be announced here and in the community group.</p>
                </div>
            <% } %>
        </div>
    </section>

    <!-- Gallery -->
    <section id="gallery" class="gallery">
        <p class="section-label">THE COMMUNITY</p>
        <h2>OUR<br>PEOPLE.</h2>

        <% if (typeof gallery_images !== 'undefined' && gallery_images.length > 0) { %>
        <div class="gallery-grid">
            <% gallery_images.forEach(function(img) { %>
            <div class="gallery-item">
                <img src="<%= img.image %>" alt="<%= img.caption || 'The 52 Club Community' %>" loading="lazy">
                <% if (img.caption) { %>
                <div class="gallery-caption"><%= img.caption %></div>
                <% } %>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <div class="gallery-placeholder">
            <p>
                YOUR GALLERY<br>
                COMING SOON
            </p>
        </div>
        <% } %>
    </section>

    <!-- Register -->
    <section id="register" class="register">
        <p class="section-label">READY?</p>
        <h2>
            JOIN<br>
            THE <span>52.</span>
        </h2>
        <p class="register-intro">
            Become part of the community.
        </p>

        <form class="register-form" id="registerForm" method="post" action="/register/">
            <% if (typeof formErrors !== 'undefined' && formErrors && formErrors.length > 0) { %>
            <div class="form-errors" style="color: #ffffff; background: #111111; border: 1px solid #ffffff; padding: 14px 18px; border-radius: 6px; margin-bottom: 24px; font-size: 14px;">
                <p style="font-weight: 700; margin-bottom: 8px;">⚠️ Please correct the errors below:</p>
                <ul style="margin-left: 20px;">
                    <% formErrors.forEach(function(err) { %>
                    <li><%= err %></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>

            <div class="form-group">
                <label for="name">FULL NAME</label>
                <input type="text" name="full_name" placeholder="Enter your full name" id="name" required value="<%= typeof formData !== 'undefined' && formData.full_name ? formData.full_name : '' %>">
            </div>

            <div class="form-group">
                <label for="email">EMAIL</label>
                <input type="email" name="email" placeholder="Enter your email" id="email" required value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
            </div>

            <div class="form-group">
                <label for="phone">PHONE NUMBER</label>
                <input type="tel" name="phone" placeholder="Enter your phone number" id="phone" required value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>">
            </div>

            <div class="form-group">
                <label for="experience">STRENGTH / TRAINING EXPERIENCE</label>
                <select name="experience" id="experience">
                    <option value="beginner" <%= typeof formData !== 'undefined' && formData.experience === 'beginner' ? 'selected' : '' %>>Beginner</option>
                    <option value="intermediate" <%= typeof formData !== 'undefined' && formData.experience === 'intermediate' ? 'selected' : '' %>>Intermediate</option>
                    <option value="advanced" <%= typeof formData !== 'undefined' && formData.experience === 'advanced' ? 'selected' : '' %>>Advanced</option>
                </select>
            </div>

            <div class="form-group">
                <label for="message">TELL US ABOUT YOURSELF</label>
                <textarea name="message" rows="5" placeholder="What brings you to The 52 Club?" id="message"><%= typeof formData !== 'undefined' && formData.message ? formData.message : '' %></textarea>
            </div>

            <button type="submit" class="submit-btn">
                SUBMIT REGISTRATION
            </button>
        </form>
    </section>

<%- include('partials/footer', {
    extraJs: (typeof scroll_to_register !== 'undefined' && scroll_to_register) ? '<script>window.addEventListener("DOMContentLoaded", function() { document.getElementById("register").scrollIntoView({ behavior: "smooth" }); });</script>' : '',
    footer_collaborations_grouped: typeof footer_collaborations_grouped !== 'undefined' ? footer_collaborations_grouped : null
}) %>
