    <!-- Footer (Get in Touch & Collaborations) -->
    <footer class="extended-footer">
        <div class="footer-contact-container">
            <% if (typeof footer_collaborations_grouped !== 'undefined' && footer_collaborations_grouped && Object.keys(footer_collaborations_grouped).length > 0) { %>
            <div style="margin-bottom: 40px; padding-bottom: 30px; border-bottom: 1px solid rgba(255, 255, 255, 0.12);">
                <h4 class="footer-block-title" style="letter-spacing: 2px; font-size: 11px; color: #888888; margin-bottom: 20px;">PARTNERS & COLLABORATIONS</h4>
                <div style="display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start;">
                    <% Object.keys(footer_collaborations_grouped).forEach(function(cat) { %>
                    <div style="min-width: 170px;">
                        <div style="font-size: 10px; font-weight: 800; letter-spacing: 1.5px; color: #777777; text-transform: uppercase; margin-bottom: 10px;"><%= cat %></div>
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            <% footer_collaborations_grouped[cat].forEach(function(partner) { %>
                            <li style="margin-bottom: 8px;">
                                <% if (partner.url) { %>
                                    <a href="<%= partner.url %>" target="_blank" rel="noopener" style="color: #cccccc; text-decoration: none; font-weight: 600; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#cccccc'">
                                        <%= partner.name %> <span style="font-size: 11px; opacity: 0.6;">↗</span>
                                    </a>
                                <% } else { %>
                                    <span style="color: #cccccc; font-weight: 600; font-size: 13px;"><%= partner.name %></span>
                                <% } %>
                            </li>
                            <% }); %>
                        </ul>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <h4 class="footer-block-title">GET IN TOUCH</h4>

            <div class="contact-methods">
                <a href="mailto:the52clubofficial@gmail.com" class="contact-item">
                    <span class="contact-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L1 7"></path>
                        </svg>
                    </span>
                    <div class="contact-details">
                        <span class="contact-label">EMAIL US</span>
                        <span class="contact-value">the52clubofficial@gmail.com</span>
                    </div>
                </a>

                <a href="https://chat.whatsapp.com/FCe9HHDxPirCxFLsIdbRAs" target="_blank" rel="noopener" class="contact-item">
                    <span class="contact-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm5.8 14.15c-.24.67-1.39 1.28-1.92 1.33-.49.05-1.12.08-3.23-.79-2.69-1.12-4.42-3.86-4.55-4.04-.13-.18-1.08-1.44-1.08-2.75 0-1.31.69-1.95.93-2.22.24-.26.54-.33.72-.33.18 0 .36 0 .52.01.17.01.4.06.61.57.24.57.82 2.01.89 2.16.07.15.12.33.02.53-.1.2-.15.32-.3.49-.15.17-.32.38-.45.51-.15.15-.31.31-.13.62.18.31.79 1.3 1.7 2.11 1.17 1.04 2.15 1.36 2.46 1.51.31.15.49.13.67-.08.18-.21.78-.91.99-1.22.21-.31.42-.26.7-.15.28.11 1.78.84 2.09.99.31.15.52.23.6.36.08.13.08.76-.16 1.43z"/>
                        </svg>
                    </span>
                    <div class="contact-details">
                        <span class="contact-label">WHATSAPP COMMUNITY</span>
                        <span class="contact-value">Join 52 Club Group</span>
                    </div>
                </a>

                <a href="https://www.instagram.com/the52.club?igsi=cjE3M2FsZXo4M3Bu" target="_blank" rel="noopener" class="contact-item">
                    <span class="contact-icon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    </span>
                    <div class="contact-details">
                        <span class="contact-label">INSTAGRAM</span>
                        <span class="contact-value">@the52.club</span>
                    </div>
                </a>
            </div>
        </div>
    </footer>

    <% if (typeof extraJs !== 'undefined') { %>
        <%- extraJs %>
    <% } %>
</body>
</html>
